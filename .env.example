# =============================================================================
#  APPLICATION ENVIRONMENT CONFIGURATION
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development          # development | production | testing
APP_DEBUG=true               # true in dev, false in production
APP_URL=http://localhost
APP_TIMEZONE=Europe/Paris

# Encryption key — exactly 64 hex characters (32 bytes).
# Generate with:  php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# --- Database ---
DB_DRIVER=mysql              # mysql | pgsql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=app
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Session ---
SESSION_LIFETIME=7200        # seconds (2 hours)
SESSION_IDLE_TIMEOUT=1800    # auto-logout after idle (30 min)

# --- Mail (SMTP) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls          # tls | ssl | '' (none for dev)
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=App
MAIL_ADMIN_ADDRESS=

# --- Redis (optional — file fallback used if unavailable) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Cloudflare Turnstile ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate Limiting ---
RATE_LIMIT_LOGIN=5           # max attempts per window
RATE_LIMIT_API=60            # max requests per window
RATE_LIMIT_WINDOW=60         # window size in seconds

# --- File Uploads ---
UPLOAD_MAX_SIZE=10485760     # 10MB in bytes
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,gif,mp4,webm,pdf
STORAGE_PATH=storage         # relative to project root

# --- Logging ---
LOG_CHANNEL=app              # app | security | database | mail
LOG_LEVEL=debug              # debug | info | notice | warning | error | critical
LOG_PATH=logs                # relative to project root
